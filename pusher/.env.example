# --- Required ---

# Public URL of the running bot/API. For Railway:
#   https://avito-reseller-bot-bot.up.railway.app/api/duff89/webhook
WEBHOOK_URL=https://avito-reseller-bot-bot.up.railway.app/api/duff89/webhook

# Shared HMAC secret. Set the SAME value as DUFF_WEBHOOK_SECRET on the bot
# (Railway → Service → Variables). Generate any random ~40-char string.
DUFF_WEBHOOK_SECRET=replace-with-a-random-string-shared-with-railway

# --- Optional ---

# Source label written into pushed_listings.source. Keep "avito".
SOURCE=avito

# Run Chromium headless (true) or with a visible window (false). Use false the
# first time on a new machine to verify there's no captcha block.
HEADLESS=true

# Persistent browser profile dir. Cookies/auth survive between runs, which
# matters because Avito treats logged-in users much more leniently.
# Default is `<repo>/pusher/.browser-profile` (created on first run).
# PROFILE_DIR=

# Path to your targets file (catalog URLs to scrape).
# Default is `<repo>/pusher/targets.json`.
# TARGETS_FILE=

# HTTP timeout for the webhook POST, seconds.
WEBHOOK_TIMEOUT=30

# Verbose logging (debug).
PUSHER_VERBOSE=false
