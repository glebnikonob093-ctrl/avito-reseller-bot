BOT_TOKEN=123456:ABCDEF
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
POLL_INTERVAL_SECONDS=180
MAX_NEW_ITEMS_PER_RUN=15
DEFAULT_REGION=moskva
DEFAULT_CATEGORY=telefony
MAX_REQUESTS_PER_MINUTE=20

# Mini App
# Public HTTPS URL opened inside Telegram (Cloudflare/ngrok/VPS)
WEBAPP_URL=

# Local API server (FastAPI) started together with the bot
API_HOST=127.0.0.1
API_PORT=8000

# Optional outbound proxy support (HTTP/SOCKS)
# Examples:
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
TELEGRAM_PROXY_URL=

# Optional proxy for source fetching (Avito parser HTTP requests)
SOURCE_PROXY_URL=

