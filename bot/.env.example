BOT_TOKEN=123456:ABCDEF
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
POLL_INTERVAL_SECONDS=180
MAX_NEW_ITEMS_PER_RUN=15
DEFAULT_REGION=moskva
DEFAULT_CATEGORY=telefony
MAX_REQUESTS_PER_MINUTE=20

# Mini App
# Public HTTPS URL opened inside Telegram (Cloudflare/ngrok/VPS)
WEBAPP_URL=

# Local API server (FastAPI) started together with the bot
API_HOST=127.0.0.1
API_PORT=8000

# Optional outbound proxy support (HTTP/SOCKS)
# Examples:
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
TELEGRAM_PROXY_URL=

# Optional proxy for source fetching (Avito parser HTTP requests)
# You can set one proxy:
# SOURCE_PROXY_URL=http://user:pass@host:port
# or a pool (comma-separated), the bot will rotate automatically:
# SOURCE_PROXY_URL=http://p1:8080,http://p2:8080,socks5://p3:1080
SOURCE_PROXY_URL=

# Optional cloud scraping provider for Avito pages (recommended if no own proxies).
# Current supported provider:
# - scraperapi
SCRAPER_PROVIDER=scraperapi
SCRAPER_API_KEY=

# Disable mock data in production by default.
# Set to 1 only for local demos/debug.
ENABLE_MOCK_FALLBACK=0

